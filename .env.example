# Required
KAVI_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
OPENROUTER_API_KEY=replace-with-provider-key
KAVI_LLM_MODEL=replace-with-an-openrouter-model

# Kapruka MCP (public, no auth required)
KAPRUKA_MCP_URL=https://mcp.kapruka.com/mcp
KAPRUKA_MCP_PROTOCOL_VERSION=2025-06-18

# Server
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
RATE_LIMIT_PER_MINUTE=20
PUBLIC_URL=https://your-domain.example
